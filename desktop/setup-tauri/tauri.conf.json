{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dunno Setup",
  "version": "0.1.6",
  "identifier": "app.dunno.setup",
  "mainBinaryName": "dunno-setup",
  "build": {
    "frontendDist": "../dist-setup"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "setup",
        "url": "setup.html",
        "title": "dunno setup",
        "width": 640,
        "height": 440,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../src-tauri/icons/icon.ico", "../src-tauri/icons/icon.png"]
  }
}
